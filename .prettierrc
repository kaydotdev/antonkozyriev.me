{
  "plugins": ["prettier-plugin-organize-attributes"],
  "printWidth": 128,
  "htmlWhitespaceSensitivity": "css",
  "attributeGroups": ["^class$", "^(id|name)$", "$DEFAULT", "^data-", "^aria-"],
  "attributeSort": "ASC",
  "overrides": [
    {
      "files": ["src/css/reset.css", "src/css/reveal.css"],
      "options": {
        "requirePragma": true
      }
    }
  ]
}
